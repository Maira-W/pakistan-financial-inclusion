// Measures for the Pakistan financial inclusion report. Generated by `python -m fininc report`.
// All measures live in a table called _Measures. A year-filtered measure keeps the year in a VAR:
// filtering a column by a measure inside CALCULATE makes the measure invalid in Power BI.

// ---------- Helpers ----------

// The year chosen in a slicer or on an axis; the latest survey year when nothing is chosen.
Selected Year = SELECTEDVALUE ( findex[year], MAX ( findex[year] ) )

// ---------- Account ownership ----------

Account Ownership % = CALCULATE ( AVERAGE ( findex[value] ), findex[indicator] = "account.t.d" )

// Adults with an account at a bank, similar institution or mobile money provider (Global Findex).
Pakistan Account Ownership % =
VAR y = [Selected Year]
RETURN
    CALCULATE (
        AVERAGE ( findex[value] ),
        findex[country] = "PAK",
        findex[indicator] = "account.t.d",
        findex[year] = y
    )

// Women with an account (Global Findex).
Pakistan Women % =
VAR y = [Selected Year]
RETURN
    CALCULATE (
        AVERAGE ( findex[value] ),
        findex[country] = "PAK",
        findex[indicator] = "account.t.d.1",
        findex[year] = y
    )

// Men with an account (Global Findex).
Pakistan Men % =
VAR y = [Selected Year]
RETURN
    CALCULATE (
        AVERAGE ( findex[value] ),
        findex[country] = "PAK",
        findex[indicator] = "account.t.d.2",
        findex[year] = y
    )

// Men minus women with an account, in percentage points.
Account Gender Gap (pts) = [Pakistan Men %] - [Pakistan Women %]

Segment Account Ownership % = AVERAGE ( segments[value] )

Bank Barrier Share % = CALCULATE ( AVERAGE ( barriers[share] ), barriers[account_type] = "Bank or similar account" )

Mobile Money Barrier Share % = CALCULATE ( AVERAGE ( barriers[share] ), barriers[account_type] = "Mobile money account" )

Pakistan Women Phone Ownership % = CALCULATE ( AVERAGE ( countries[phone_women] ), countries[country] = "PAK" )

Pakistan Men Phone Ownership % = CALCULATE ( AVERAGE ( countries[phone_men] ), countries[country] = "PAK" )

// Men minus women who own a mobile phone, in percentage points (Global Findex 2024).
Phone Gender Gap (pts) = [Pakistan Men Phone Ownership %] - [Pakistan Women Phone Ownership %]

// ---------- Branches ----------

// Bank and microfinance bank branches in the SBP register at 31 December 2024.
Total Branches = SUM ( districts[branches_2024] )

Bank Branches = SUM ( districts[banks_2024] )

Microfinance Branches = SUM ( districts[microfinance_2024] )

Rural Branches = SUM ( districts[rural_branches_2024] )

Population = SUM ( districts[population] )

District Count = COUNTROWS ( districts )

// Branches per 100,000 people (2023 census population).
Branches per 100k = DIVIDE ( [Total Branches], [Population] ) * 100000

// Branches per 100,000 people across all 120 districts, whatever is selected.
National Branches per 100k =
DIVIDE (
    CALCULATE ( [Total Branches], ALL ( districts ) ),
    CALCULATE ( [Population], ALL ( districts ) )
) * 100000

Density vs National (x) = DIVIDE ( [Branches per 100k], [National Branches per 100k] )

People per Branch = DIVIDE ( [Population], [Total Branches] )

Rural Branch Share % = DIVIDE ( [Rural Branches], [Total Branches] ) * 100

Rural Population Share % = DIVIDE ( SUM ( districts[rural_population] ), [Population] ) * 100

Rural Branches per 100k Rural People = DIVIDE ( [Rural Branches], SUM ( districts[rural_population] ) ) * 100000

Urban Branches per 100k Urban People = DIVIDE ( SUM ( districts[urban_branches_2024] ), SUM ( districts[urban_population] ) ) * 100000

Bank Branches per 100k 2020 = DIVIDE ( SUM ( districts[banks_2020] ), SUM ( districts[population_2017] ) ) * 100000

Bank Branches per 100k 2024 = DIVIDE ( [Bank Branches], [Population] ) * 100000

Bank Branch Growth 2020-24 % =
DIVIDE (
    SUM ( districts[banks_2024] ) - SUM ( districts[banks_2020] ),
    SUM ( districts[banks_2020] )
) * 100

// Districts with fewer than half the national average of branches per person.
Districts Below Half National Avg =
VAR cutoff = [National Branches per 100k] / 2
RETURN
    COUNTROWS (
        FILTER ( districts, DIVIDE ( districts[branches_2024], districts[population] ) * 100000 < cutoff )
    )

// Share of the national population living in those districts.
Population Share in Low-Density Districts % =
VAR cutoff = [National Branches per 100k] / 2
RETURN
    DIVIDE (
        SUMX (
            FILTER ( districts, DIVIDE ( districts[branches_2024], districts[population] ) * 100000 < cutoff ),
            districts[population]
        ),
        CALCULATE ( [Population], ALL ( districts ) )
    )

// The measure chosen in the Measure slicer on the District explorer page.
Selected District Metric =
SWITCH (
    SELECTEDVALUE ( metric_choice[metric], "Branches per 100,000 people" ),
    "Branches per 100,000 people", [Branches per 100k],
    "People per branch", [People per Branch],
    "Rural branches per 100,000 rural people", [Rural Branches per 100k Rural People],
    "Expected branches", [Expected Branches],
    "Shortfall against expected (branches)", [Total Shortfall],
    BLANK ()
)

// ---------- Access gap model ----------

// Branches a district would be expected to have given its size, urban share and development (leave-one-out model).
Expected Branches = SUM ( districts[expected_branches] )

Expected Branches per 100k = DIVIDE ( [Expected Branches], [Population] ) * 100000

// Expected minus actual branches, counting only districts below expectation.
Total Shortfall = SUMX ( districts, MAX ( districts[shortfall], 0 ) )

Top Gap Shortfall = SUM ( top_gaps[shortfall] )

Districts Below Expected = CALCULATE ( COUNTROWS ( districts ), districts[below_expected] = TRUE () )

// Districts where the chance of so few branches is under 10% and the count is also below the bootstrap range. A perfect model would still flag about one district in ten, so use the list for review.
Districts Flagged Below Expected = CALCULATE ( COUNTROWS ( districts ), districts[flagged_short] = TRUE () )

Model Shortfall (branches) = MAX ( headline[total_shortfall] )

Shortfall 5th Percentile = MAX ( headline[shortfall_p05] )

Shortfall 95th Percentile = MAX ( headline[shortfall_p95] )

// Fall in the average miss of the leave-one-out model against a rule that gives every district the same branches per person.
Model Error Reduction % = MAX ( headline[model_error_reduction_pct] )

Gini of Bank Branches 2020 = MAX ( headline[gini_banks_2020] )

// Inequality of bank branches against population across districts: 0 is even, 1 is one district.
Gini of Bank Branches 2024 = MAX ( headline[gini_banks_2024] )

// Share of net new bank branches since 2020 that went to the half of districts that started with fewer branches per person.
New Branches Reaching Low-Density Half % = MAX ( headline[low_density_share_of_new_pct] )

Population in Low-Density Half % = MAX ( headline[low_density_share_of_population_pct] )

// ---------- Planner ----------

// Gini of branches after the planner places new points under the rule and size shown.
Scenario Gini = AVERAGE ( scenario[gini] )

Scenario Population Below Half % = AVERAGE ( scenario[population_below_half_pct] )

Scenario Districts Below Half = AVERAGE ( scenario[districts_below_half] )

Scenario Worst People per Branch = AVERAGE ( scenario[worst_people_per_branch] )

Scenario Share to Low Female Literacy % = AVERAGE ( scenario[share_to_low_female_literacy_pct] )

Gini Today = CALCULATE ( AVERAGE ( scenario[gini] ), scenario[points_added] = 0, scenario[rule_key] = "equity" )

Gini After 1000 Points (Even People per Branch) = CALCULATE ( AVERAGE ( scenario[gini] ), scenario[points_added] = 1000, scenario[rule_key] = "equity" )

Gini After 1000 Points (Model Gap First) = CALCULATE ( AVERAGE ( scenario[gini] ), scenario[points_added] = 1000, scenario[rule_key] = "gap" )

Districts Below Half Today = CALCULATE ( AVERAGE ( scenario[districts_below_half] ), scenario[points_added] = 0, scenario[rule_key] = "equity" )

Districts Below Half After 1000 Points (Even People per Branch) = CALCULATE ( AVERAGE ( scenario[districts_below_half] ), scenario[points_added] = 1000, scenario[rule_key] = "equity" )

// ---------- Digital layer ----------

Wallet Agents per 100k Adults = AVERAGE ( wallet[agents_per_100k_adults] )

Wallet Accounts per 100 Adults = AVERAGE ( wallet[accounts_per_100_adults] )

Wallet Women Share % = AVERAGE ( wallet[female_share] )

Active Agent Share % = AVERAGE ( wallet_national[active_agent_share] )

Active Account Share % = AVERAGE ( wallet_national[active_account_share] )

Latest Wallet Accounts (million) =
VAR q = MAX ( wallet_national[quarter_index] )
RETURN
    DIVIDE ( CALCULATE ( SUM ( wallet_national[accounts] ), wallet_national[quarter_index] = q ), 1000000 )

Latest Wallet Agents (thousand) =
VAR q = MAX ( wallet_national[quarter_index] )
RETURN
    DIVIDE ( CALCULATE ( SUM ( wallet_national[agents] ), wallet_national[quarter_index] = q ), 1000 )

// Registered branchless banking agents that were active in the latest quarter.
Latest Active Agent Share % =
VAR q = MAX ( wallet_national[quarter_index] )
RETURN
    CALCULATE ( AVERAGE ( wallet_national[active_agent_share] ), wallet_national[quarter_index] = q )

First Active Agent Share % =
VAR q = MIN ( wallet_national[quarter_index] )
RETURN
    CALCULATE ( AVERAGE ( wallet_national[active_agent_share] ), wallet_national[quarter_index] = q )

Latest Wallet Deposits (PKR billion) =
VAR q = MAX ( wallet_national[quarter_index] )
RETURN
    DIVIDE ( CALCULATE ( SUM ( wallet_national[deposits_pkr_mn] ), wallet_national[quarter_index] = q ), 1000 )

// ---------- Income benchmark ----------

Country GDP per Person = AVERAGE ( countries[gdp_pc_ppp] )

Country Account Ownership % = AVERAGE ( countries[account] )

Expected Account Ownership % = AVERAGE ( countries[expected_account] )

Pakistan Expected Account Ownership % = CALCULATE ( AVERAGE ( countries[expected_account] ), countries[country] = "PAK" )

// Account ownership expected at Pakistan's income minus the actual figure, in points.
Pakistan Account Shortfall vs Income (pts) =
CALCULATE (
    AVERAGE ( countries[expected_account] ) - AVERAGE ( countries[account] ),
    countries[country] = "PAK"
)

Economies Compared = COUNTROWS ( ALL ( countries ) )

// Pakistan's position when economies are ordered from lowest account ownership.
Pakistan Rank From Lowest =
VAR pak = CALCULATE ( AVERAGE ( countries[account] ), countries[country] = "PAK" )
RETURN
    COUNTROWS ( FILTER ( ALL ( countries ), countries[account] <= pak ) )
