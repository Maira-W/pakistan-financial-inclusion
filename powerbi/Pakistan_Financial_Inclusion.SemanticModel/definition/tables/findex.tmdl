table findex

	column country
		dataType: string
		summarizeBy: none
		sourceColumn: country

	column country_name
		dataType: string
		summarizeBy: none
		sourceColumn: country_name

	column indicator
		dataType: string
		summarizeBy: none
		sourceColumn: indicator

	column label
		dataType: string
		summarizeBy: none
		sourceColumn: label

	column group
		dataType: string
		summarizeBy: none
		sourceColumn: group

	column year
		dataType: int64
		summarizeBy: none
		sourceColumn: year

	column value
		dataType: double
		summarizeBy: none
		sourceColumn: value

	partition findex = m
		mode: import
		source =
				let
					Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [country = _t, country_name = _t, indicator = _t, label = _t, group = _t, year = _t, value = _t]),
					Typed = Table.TransformColumnTypes(Source, {{"country", type text}, {"country_name", type text}, {"indicator", type text}, {"label", type text}, {"group", type text}, {"year", Int64.Type}, {"value", type number}}, "en-US")
				in
					Typed

