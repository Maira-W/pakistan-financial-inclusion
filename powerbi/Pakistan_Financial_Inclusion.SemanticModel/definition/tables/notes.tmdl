table notes

	column topic
		dataType: string
		summarizeBy: none
		sourceColumn: topic

	column note
		dataType: string
		summarizeBy: none
		sourceColumn: note

	partition notes = m
		mode: import
		source =
				let
					Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [topic = _t, note = _t]),
					Typed = Table.TransformColumnTypes(Source, {{"topic", type text}, {"note", type text}}, "en-US")
				in
					Typed

