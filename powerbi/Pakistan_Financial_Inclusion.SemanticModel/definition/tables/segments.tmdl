table segments

	column segment
		dataType: string
		summarizeBy: none
		sourceColumn: segment

	column group
		dataType: string
		summarizeBy: none
		sourceColumn: group

	column year
		dataType: int64
		summarizeBy: none
		sourceColumn: year

	column value
		dataType: double
		summarizeBy: none
		sourceColumn: value

	partition segments = m
		mode: import
		source =
				let
					Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [segment = _t, group = _t, year = _t, value = _t]),
					Typed = Table.TransformColumnTypes(Source, {{"segment", type text}, {"group", type text}, {"year", Int64.Type}, {"value", type number}}, "en-US")
				in
					Typed

