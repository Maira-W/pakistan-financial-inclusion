	partition top_gaps = m
		mode: import
		source =
				let
					Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [gap_rank = _t, district = _t, province = _t, district_type = _t, population = _t, branches_2024 = _t, expected_branches = _t, expected_low = _t, expected_high = _t, shortfall = _t, chance_of_this_few = _t, flagged_short = _t]),
					Typed = Table.TransformColumnTypes(Source, {{"gap_rank", Int64.Type}, {"district", type text}, {"province", type text}, {"district_type", type text}, {"population", Int64.Type}, {"branches_2024", Int64.Type}, {"expected_branches", type number}, {"expected_low", type number}, {"expected_high", type number}, {"shortfall", type number}, {"chance_of_this_few", type number}, {"flagged_short", type logical}}, "en-US")
