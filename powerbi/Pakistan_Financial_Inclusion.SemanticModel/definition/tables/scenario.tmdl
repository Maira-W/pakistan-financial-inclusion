					Typed = Table.TransformColumnTypes(Source, {{"points_added", Int64.Type}, {"rule_key", type text}, {"rule", type text}, {"points_placed", Int64.Type}, {"national_density", type number}, {"districts_below_half", Int64.Type}, {"population_below_half_pct", type number}, {"gini", type number}, {"worst_people_per_branch", type number}, {"share_to_low_female_literacy_pct", type number}}, "en-US")
