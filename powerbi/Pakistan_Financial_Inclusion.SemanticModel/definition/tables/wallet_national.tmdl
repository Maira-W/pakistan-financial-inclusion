	partition wallet_national = m
		mode: import
		source =
				let
					Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [quarter = _t, label = _t, quarter_index = _t, agents = _t, active_agents = _t, accounts = _t, active_accounts = _t, deposits_pkr_mn = _t, active_account_share = _t, active_agent_share = _t]),
					Typed = Table.TransformColumnTypes(Source, {{"quarter", type text}, {"label", type text}, {"quarter_index", Int64.Type}, {"agents", type number}, {"active_agents", type number}, {"accounts", type number}, {"active_accounts", type number}, {"deposits_pkr_mn", type number}, {"active_account_share", type number}, {"active_agent_share", type number}}, "en-US")
				in
