table provinces

	column province
		dataType: string
		summarizeBy: none
		sourceColumn: province

	column province_code
		dataType: string
		summarizeBy: none
		sourceColumn: province_code

	partition provinces = m
		mode: import
		source =
				let
					Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i45WckrMyU/OyCwuScxT0lFyclSK1YlW8izOScxNTEpMAQp5OoeAxbwzKpNSixQCErMzSkrzsjPKE4GS3gFguYDSvKzEJCA/wAnMD87MS8kAcoNdlGJjAQ==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [province = _t, province_code = _t]),
					Typed = Table.TransformColumnTypes(Source, {{"province", type text}, {"province_code", type text}}, "en-US")
				in
					Typed

