table wallet

	column region
		dataType: string
		summarizeBy: none
		sourceColumn: region

	column quarter
		dataType: string
		summarizeBy: none
		sourceColumn: quarter

	column quarter_label
		dataType: string
		summarizeBy: none
		sourceColumn: quarter_label

	column accounts
		dataType: double
		summarizeBy: none
		sourceColumn: accounts

	column agents
		dataType: double
		summarizeBy: none
		sourceColumn: agents

	column adults_15plus
		dataType: double
		summarizeBy: none
		sourceColumn: adults_15plus

	column accounts_per_100_adults
		dataType: double
		summarizeBy: none
		sourceColumn: accounts_per_100_adults

	column agents_per_100k_adults
		dataType: double
		summarizeBy: none
		sourceColumn: agents_per_100k_adults

	column female_share
		dataType: double
		summarizeBy: none
		sourceColumn: female_share

	column figure_withheld
		dataType: boolean
		summarizeBy: none
		sourceColumn: figure_withheld

	partition wallet = m
		mode: import
		source =
				let
					Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [region = _t, quarter = _t, quarter_label = _t, accounts = _t, agents = _t, adults_15plus = _t, accounts_per_100_adults = _t, agents_per_100k_adults = _t, female_share = _t, figure_withheld = _t]),
					Typed = Table.TransformColumnTypes(Source, {{"region", type text}, {"quarter", type text}, {"quarter_label", type text}, {"accounts", type number}, {"agents", type number}, {"adults_15plus", type number}, {"accounts_per_100_adults", type number}, {"agents_per_100k_adults", type number}, {"female_share", type number}, {"figure_withheld", type logical}}, "en-US")
				in
					Typed

